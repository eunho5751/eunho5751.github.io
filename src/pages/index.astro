---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { HOME, highlight } from '../consts';
import { getPosts, getProjects } from '../lib';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, HOME.projectCount);
const posts = (await getPosts()).slice(0, HOME.postCount);
const external = (url: string) => /^https?:\/\//.test(url);
---
<Base>
  <section class:list={['hero', { 'has-image': HOME.image }]}>
    <div>
      {HOME.eyebrow && <p class="eyebrow">{HOME.eyebrow}</p>}
      <h1 set:html={highlight(HOME.heading)} />
      <p class="lead" style="white-space: pre-line">{HOME.lead}</p>
      <div class="cta">
        {HOME.buttons.map((b) => (
          <a
            class:list={['btn', { primary: b.primary }]}
            href={b.url}
            {...(external(b.url) ? { target: '_blank', rel: 'noopener' } : {})}
          >{b.label}</a>
        ))}
      </div>
    </div>
    {HOME.image && <img class="hero-image" src={HOME.image} alt="" />}
  </section>

  {projects.length > 0 && (
    <section>
      <div class="section-head"><h2>{HOME.projectsTitle}</h2><a href="/projects/">전체 보기 →</a></div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}

  <section>
    <div class="section-head"><h2>{HOME.postsTitle}</h2><a href="/blog/">전체 보기 →</a></div>
    {posts.length ? <PostList posts={posts} /> : <p class="muted">아직 글이 없습니다.</p>}
  </section>
</Base>
