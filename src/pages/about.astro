---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md 가 없습니다.');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.lead}>
  <article class="prose-wrap">
    {page.data.image && <img class="about-image" src={page.data.image} alt="" />}
    <h1>{page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>
